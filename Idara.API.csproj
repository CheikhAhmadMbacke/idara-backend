<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>idara-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.45.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

  <!-- Polices des PDF. QuestPDF n'embarque que Lato (aucun glyphe arabe) : sans
       ces fichiers DANS LA PUBLICATION, les noms arabes repartent en carrés en
       production alors que tout va bien en local. Volontairement hors wwwroot :
       ces fichiers n'ont aucune raison d'être servis publiquement. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Guide pas à pas de l'assistant IA (§300) : EMBARQUÉ dans l'assemblage,
       donc impossible de l'oublier au déploiement. Généré par
       Tools/build-assistant-guide.js ; le modèle (template) n'est pas embarqué.
       WithCulture="false" : sans lui, MSBuild lit « .fr » / « .ar » comme une
       CULTURE et range le guide dans un assemblage satellite — introuvable. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\AssistantGuide\guide.fr.md" LogicalName="AssistantGuide.fr.md" WithCulture="false" />
    <EmbeddedResource Include="Assets\AssistantGuide\guide.ar.md" LogicalName="AssistantGuide.ar.md" WithCulture="false" />
  </ItemGroup>

</Project>
